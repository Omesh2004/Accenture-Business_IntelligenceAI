DEPLOYMENT_MODE=CLOUD
KAFKA_BROKER_URL=broker:29092
KAFKA_TOPIC_EVENTS=feature-events
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=feature_intelligence
API_PORT_INGESTION=8000
API_PORT_ANALYTICS=8001
# Local model server, reached from inside the containers. Ollama speaks the same
# OpenAI-compatible API, so only the URL and the model name change.
VLLM_URL=http://host.docker.internal:11434/v1
HF_TOKEN=

EXTRACT_API_TOKEN=local-dev-extract-token

# Intelligence layer LLM narrator. 0 = deterministic templates (default, no GPU needed).
# 1 = use the vLLM server; requires an NVIDIA GPU and `docker compose --profile gpu up vllm-server`.
INTELLIGENCE_LLM=1

# vLLM: pin the served model instead of letting free VRAM pick a tier.
# The narrator asks the server what it serves, so INTEL_LLM_MODEL can stay unset.
VLLM_MODEL=fininsights-narrator
VLLM_MAX_LEN=8192
VLLM_GPU_UTIL=0.80
