generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  email            String            @unique
  phone            String            @unique
  password         String
  customerType     CustomerType      @default(INDIVIDUAL)
  dateOfBirth      DateTime
  pan              String            @unique
  settingConfig    Json
  address          Json
  role             CustomerRole      @default(USER)
  tenantId         String            @default("bank_a")
  account          Account[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  events           Event[]
  loanApplications LoanApplication[]
  payee            Payee[]           @relation("payee")
  payer            Payee[]           @relation("payer")
  locations        UserLocation[]
  licenses         UserLicense[]
  kycStatus        KycStatus         @default(NOT_STARTED)
  kycCompletedAt   DateTime?
  lastLogin        DateTime?

  // CRM attributes (source B). Brackets rather than raw values: they are cube dimensions, and a
  // raw age or salary is neither invariant within a session nor safe to localize on.
  ageBracket       AgeBracket?
  incomeBracket    IncomeBracket?
  employmentStatus EmploymentStatus?
  riskSegment      RiskSegment?
  lifetimeValue    Float                 @default(0)
  branchCode       String?
  branch           Branch?               @relation(fields: [branchCode], references: [code])
  interactions     CampaignInteraction[]
  cards            Card[]
  notifications    Notification[]
}

model Tenant {
  id         String          @id
  name       String
  ifscPrefix String
  branchCode String
  customers  Customer[]
  toggles    FeatureToggle[]
  branches   Branch[]
  campaigns  Campaign[]
}

model Account {
  accNo       String        @id @unique
  customerId  String        @db.Uuid
  ifsc        String
  accountType AccountType   @default(SAVINGS)
  balance     Float         @default(0)
  createdOn   DateTime      @default(now())
  updatedOn   DateTime      @updatedAt
  deletedOn   DateTime?
  investment  Json[]
  customer    Customer      @relation(fields: [customerId], references: [id])
  loans       Loan[]
  payer       Payee[]
  received    Transaction[] @relation("received")
  sent        Transaction[] @relation("sent")

  /// The ONE account state. Transfers gate on it and analytics reads it, so there is nothing
  /// for a second flag to disagree with. Only ACTIVE may transact.
  lifecycleStatus AccountStatus @default(ACTIVE)
  interestRate    Float         @default(0)
  branchCode      String?
  branch          Branch?       @relation(fields: [branchCode], references: [code])
  cards           Card[]
}

model Transaction {
  id              String             @id @default(uuid()) @db.Uuid
  transactionType TransactionType
  senderAccNo     String
  receiverAccNo   String
  amount          Float
  status          TransactionStatus  @default(SUCCESS)
  category        String
  channel         TransactionChannel @default(WEB)
  description     String?
  timestamp       DateTime           @default(now())
  /// Mutation clock. `timestamp` is event time and never moves, so an extract cursoring on it
  /// can never see a status change (SUCCESS -> PENDING/REVERSED) and the analytics copy keeps a
  /// settled state forever. Every KPI filtering status = SUCCESS depends on this.
  updatedOn       DateTime           @default(now()) @updatedAt
  loanId          String?            @db.Uuid
  loan            Loan?              @relation(fields: [loanId], references: [id])
  receiverAccount Account            @relation("received", fields: [receiverAccNo], references: [accNo])
  senderAccount   Account            @relation("sent", fields: [senderAccNo], references: [accNo])

  merchantCategoryCode String? // ISO 18245 MCC
  merchantName         String?
  referenceNumber      String?
}

model Loan {
  id              String        @id @default(uuid()) @db.Uuid
  loanType        LoanType
  interestRate    Float
  principalAmount Float
  interestAmount  Float
  term            Int
  startDate       DateTime
  endDate         DateTime
  /// Enum, not a boolean: "not active" and "written off" are different facts to a lender.
  status          LoanStatus    @default(ACTIVE)
  createdOn       DateTime      @default(now())
  updatedOn       DateTime      @updatedAt
  schedule        Json[]
  dueAmount       Float
  accNo           String
  Account         Account       @relation(fields: [accNo], references: [accNo])
  payment         Transaction[]
}

model LoanApplication {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  loanType        LoanType
  principalAmount Float
  term            Int
  interestRate    Float
  status          ApplicationStatus @default(PENDING)
  kycData         Json
  kycStep         Int               @default(0)
  notes           String?
  reviewedBy      String?           @db.Uuid
  createdOn       DateTime          @default(now())
  updatedOn       DateTime          @updatedAt
  customer        Customer          @relation(fields: [customerId], references: [id])
}

model Payee {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  payeeAccNo      String
  payeeifsc       String
  payeeCustomerId String       @db.Uuid
  payerCustomerId String       @db.Uuid
  payeeType       CustomerType @default(INDIVIDUAL)
  payeeAccount    Account      @relation(fields: [payeeAccNo], references: [accNo])
  payeeCustome    Customer     @relation("payee", fields: [payeeCustomerId], references: [id])
  payerCustomer   Customer     @relation("payer", fields: [payerCustomerId], references: [id])
  bankName        String?
  nickname        String?
}

model Event {
  id         String    @id @default(uuid()) @db.Uuid
  eventName  String
  tenantId   String
  userId     String
  customerId String?   @db.Uuid
  metadata   Json
  timestamp  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model UserLocation {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  latitude   Float?
  longitude  Float?
  country    String?
  city       String?
  ip         String?
  deviceType String?
  userAgent  String?
  platform   String?
  timestamp  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
}

model UserLicense {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  featureId  String
  amount     Float
  expiryDate DateTime
  active     Boolean  @default(true)
  createdOn  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, featureId])
}

model FeatureToggle {
  id       String  @id @default(uuid()) @db.Uuid
  key      String
  enabled  Boolean @default(true)
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([key, tenantId])
}

enum CustomerRole {
  USER
  ADMIN
}

enum CustomerType {
  INDIVIDUAL
  SHOPPING
  ENTERTAINMENT
  HOUSING
  FOOD
  OTHERS
}

enum AccountType {
  SAVINGS
  CURRENT
  LOAN
  CREDIT_CARD
  INVESTMENT
}

enum TransactionType {
  PAYMENT
  TRANSFER
  PRO_LICENSE_FEE
  DEPOSIT
  WITHDRAWAL
}

enum LoanType {
  HOME
  AUTO
  PERSONAL
  STUDENT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  KYC_PENDING
  UNDER_REVIEW
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionChannel {
  WEB
  MOBILE
  ATM
  POS
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
  REVERSED
}

// ═══════════════════════════════════════════════════════════════════════════
// Source B — CRM & marketing (weekly cadence, customer/campaign grain)
// Source C — branch operations and macro environment (monthly, regional grain)
// Both are separate SYSTEMS in the story, so they are separate tables here and
// separate source_ids downstream. Grain and cadence differ deliberately: one
// global freshness rule cannot gate all three.
// ═══════════════════════════════════════════════════════════════════════════

model Branch {
  code              String     @id @unique
  name              String
  /// Continent. Matches the dashboard's Geographic Distribution continent view.
  region            String
  /// Country, from the same worldwide vocabulary the clickstream emits, so a retail KPI and the
  /// dashboard's country view name the same places.
  country           String     @default("")
  city              String
  managerName       String
  staffingHeadcount Int        @default(0)
  openedOn          DateTime
  tenantId          String     @default("bank_a")
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  updatedOn         DateTime   @updatedAt
  customers         Customer[]
  accounts          Account[]
}

/// One row per region per month. The external driver the engine must reach for when an internal
/// cause does not explain a deposit movement.
model MacroEnvironment {
  id                       String   @id @default(uuid()) @db.Uuid
  region                   String
  monthYear                String // YYYY-MM
  competitorDepositRate    Float
  centralBankBaseRate      Float
  regionalUnemploymentRate Float
  recordedOn               DateTime
  updatedOn                DateTime @updatedAt

  @@unique([region, monthYear])
}

model Campaign {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  channel       CampaignChannel
  targetSegment String
  startDate     DateTime
  endDate       DateTime
  spend         Float                 @default(0)
  tenantId      String                @default("bank_a")
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  updatedOn     DateTime              @updatedAt
  interactions  CampaignInteraction[]
}

/// The funnel CPA is computed from. Stored as events, never as a pre-aggregated rate: a rate
/// cannot be re-aggregated across segments.
model CampaignInteraction {
  id         String          @id @default(uuid()) @db.Uuid
  campaignId String          @db.Uuid
  customerId String          @db.Uuid
  type       InteractionType
  occurredAt DateTime
  updatedOn  DateTime        @updatedAt
  campaign   Campaign        @relation(fields: [campaignId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])

  @@index([campaignId, type])
}

model Card {
  id              String      @id @default(uuid()) @db.Uuid
  accNo           String
  customerId      String      @db.Uuid
  last4           String
  cardType        CardType
  network         CardNetwork
  /// Product name is the launch dimension: a new product is the sparse-history KPI.
  productName     String
  expMonth        Int
  expYear         Int
  cardholderName  String
  status          CardStatus  @default(ACTIVE)
  creditLimit     Float?
  availableCredit Float?
  issuedOn        DateTime
  updatedOn       DateTime    @updatedAt
  account         Account     @relation(fields: [accNo], references: [accNo])
  customer        Customer    @relation(fields: [customerId], references: [id])

  @@index([productName])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  customerId String           @db.Uuid
  type       NotificationType
  message    String
  isRead     Boolean          @default(false)
  createdOn  DateTime         @default(now())
  updatedOn  DateTime         @updatedAt
  customer   Customer         @relation(fields: [customerId], references: [id])
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
  WRITTEN_OFF
}

enum AccountStatus {
  ACTIVE
  DORMANT
  FROZEN
  CLOSED
}

enum AgeBracket {
  UNDER_25
  AGE_25_34
  AGE_35_49
  AGE_50_64
  AGE_65_PLUS
}

enum IncomeBracket {
  UNDER_30K
  INC_30K_60K
  INC_60K_100K
  INC_100K_200K
  INC_200K_PLUS
}

enum EmploymentStatus {
  SALARIED
  SELF_EMPLOYED
  STUDENT
  RETIRED
  UNEMPLOYED
}

enum RiskSegment {
  LOW
  MEDIUM
  HIGH
}

enum CampaignChannel {
  EMAIL
  SMS
  APP_PUSH
  BRANCH
}

enum InteractionType {
  SENT
  OPENED
  CLICKED
  CONVERTED
}

enum CardType {
  DEBIT
  CREDIT
  VIRTUAL
}

enum CardNetwork {
  VISA
  MASTERCARD
  AMEX
  RUPAY
}

enum CardStatus {
  ACTIVE
  LOCKED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  SECURITY
  TRANSACTION
  MARKETING
  SYSTEM
}
